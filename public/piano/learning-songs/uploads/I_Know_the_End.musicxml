      <miscellaneous-field name="caption-lyric-line-positions">[{"lyric_line_id":1,"text":"Somewhere in Germany but I can't place it","section":"Verse 1","caption_start_s":26.8,"measure":7,"offset_ticks":596,"caption_confidence":"medium"},{"lyric_line_id":2,"text":"Man, I hate this part of Texas","section":"Verse 1","caption_start_s":31.48,"measure":9,"offset_ticks":0,"caption_confidence":"medium"},{"lyric_line_id":3,"text":"Close my eyes, fantasize","section":"Verse 1","caption_start_s":34.76,"measure":10,"offset_ticks":0,"caption_confidence":"medium"},{"lyric_line_id":4,"text":"Three clicks and I'm home","section":"Verse 1","caption_start_s":38.28,"measure":11,"offset_ticks":0,"caption_confidence":"medium"},{"lyric_line_id":5,"text":"When I get back I'll lay around","section":"Verse 1","caption_start_s":41.36,"measure":12,"offset_ticks":1613,"caption_confidence":"medium"},{"lyric_line_id":6,"text":"And I'll get up and lay back down","section":"Verse 1","caption_start_s":44.52,"measure":13,"offset_ticks":1748,"caption_confidence":"medium"},{"lyric_line_id":7,"text":"Romanticize the quiet life","section":"Verse 1","caption_start_s":48.0,"measure":15,"offset_ticks":0,"caption_confidence":"medium-low"},{"lyric_line_id":8,"text":"There's no place like my room","section":"Verse 1","caption_start_s":51.36,"measure":15,"offset_ticks":1812,"caption_confidence":"medium"},{"lyric_line_id":9,"text":"But you gotta go","section":"Chorus 1","caption_start_s":57.2,"measure":19,"offset_ticks":977,"caption_confidence":"medium"},{"lyric_line_id":10,"text":"I know, I know, I know","section":"Chorus 1","caption_start_s":59.44,"measure":20,"offset_ticks":1652,"caption_confidence":"low"},{"lyric_line_id":11,"text":"Like a wave that crashed and melted on the shore","section":"Chorus 1","caption_start_s":64.239,"measure":22,"offset_ticks":1616,"caption_confidence":"medium"},{"lyric_line_id":12,"text":"Not even the burnouts are out here anymore","section":"Chorus 1","caption_start_s":70.72,"measure":25,"offset_ticks":1440,"caption_confidence":"medium"},{"lyric_line_id":13,"text":"And you had to go","section":"Chorus 1","caption_start_s":77.6,"measure":28,"offset_ticks":1519,"caption_confidence":"medium"},{"lyric_line_id":14,"text":"I know, I know, I know","section":"Chorus 1","caption_start_s":80.0,"measure":29,"offset_ticks":1141,"caption_confidence":"low"},{"lyric_line_id":15,"text":"Out in the park we watch the sunset","section":"Verse 2","caption_start_s":87.92,"measure":34,"offset_ticks":1361,"caption_confidence":"medium-low"},{"lyric_line_id":16,"text":"Talking on a rusty swing set","section":"Verse 2","caption_start_s":91.96,"measure":36,"offset_ticks":0,"caption_confidence":"medium"},{"lyric_line_id":17,"text":"After a while you went quiet and I got mean","section":"Verse 2","caption_start_s":95.44,"measure":37,"offset_ticks":0,"caption_confidence":"medium"},{"lyric_line_id":18,"text":"Always pushing you away from me","section":"Verse 2","caption_start_s":101.72,"measure":39,"offset_ticks":1440,"caption_confidence":"medium"},{"lyric_line_id":19,"text":"But you come back with gravity","section":"Verse 2","caption_start_s":105.48,"measure":40,"offset_ticks":1831,"caption_confidence":"medium"},{"lyric_line_id":20,"text":"And when I call you come home","section":"Verse 2","caption_start_s":108.96,"measure":41,"offset_ticks":1875,"caption_confidence":"medium"},{"lyric_line_id":21,"text":"A bird in your teeth","section":"Verse 2","caption_start_s":112.52,"measure":43,"offset_ticks":935,"caption_confidence":"medium"},{"lyric_line_id":22,"text":"So I gotta go","section":"Chorus 2","caption_start_s":117.8,"measure":46,"offset_ticks":949,"caption_confidence":"medium"},{"lyric_line_id":23,"text":"I know, I know, I know","section":"Chorus 2","caption_start_s":120.2,"measure":47,"offset_ticks":1658,"caption_confidence":"low"},{"lyric_line_id":24,"text":"When the sirens sound you'll hide under the floor","section":"Chorus 2","caption_start_s":125.0,"measure":49,"offset_ticks":1646,"caption_confidence":"medium-low"},{"lyric_line_id":25,"text":"But I'm not gonna go down with my hometown in a tornado","section":"Chorus 2","caption_start_s":131.28,"measure":52,"offset_ticks":1350,"caption_confidence":"medium"},{"lyric_line_id":26,"text":"I'm gonna chase it","section":"Chorus 2","caption_start_s":138.72,"measure":56,"offset_ticks":1203,"caption_confidence":"medium"},{"lyric_line_id":27,"text":"I know, I know, I know","section":"Chorus 2","caption_start_s":141.4,"measure":57,"offset_ticks":1297,"caption_confidence":"low"},{"lyric_line_id":28,"text":"I gotta go now","section":"Chorus 2","caption_start_s":145.52,"measure":59,"offset_ticks":1483,"caption_confidence":"medium"},{"lyric_line_id":29,"text":"I know, I know, I know","section":"Chorus 2","caption_start_s":148.08,"measure":60,"offset_ticks":1244,"caption_confidence":"low"},{"lyric_line_id":30,"text":"Driving out into the sun","section":"Outro","caption_start_s":179.6,"measure":76,"offset_ticks":0,"caption_confidence":"medium"},{"lyric_line_id":31,"text":"Let the ultraviolet cover me up","section":"Outro","caption_start_s":183.76,"measure":78,"offset_ticks":1053,"caption_confidence":"medium-low"},{"lyric_line_id":32,"text":"Went looking for a creation myth","section":"Outro","caption_start_s":188.56,"measure":81,"offset_ticks":508,"caption_confidence":"low"},{"lyric_line_id":33,"text":"Ended up with a pair of cracked lips","section":"Outro","caption_start_s":193.64,"measure":83,"offset_ticks":1184,"caption_confidence":"medium"},{"lyric_line_id":34,"text":"Windows down, scream along","section":"Outro","caption_start_s":197.88,"measure":86,"offset_ticks":679,"caption_confidence":"medium"},{"lyric_line_id":35,"text":"To some America first rap country song","section":"Outro","caption_start_s":201.84,"measure":88,"offset_ticks":183,"caption_confidence":"medium-low"},{"lyric_line_id":36,"text":"A slaughterhouse, an outlet mall","section":"Outro","caption_start_s":206.48,"measure":91,"offset_ticks":570,"caption_confidence":"low"},{"lyric_line_id":37,"text":"Slot machines, fear of God","section":"Outro","caption_start_s":211.48,"measure":93,"offset_ticks":1254,"caption_confidence":"medium-low"},{"lyric_line_id":38,"text":"Windows down, heater on","section":"Outro","caption_start_s":215.8,"measure":96,"offset_ticks":700,"caption_confidence":"medium"},{"lyric_line_id":39,"text":"Big bolts of lightning hanging low","section":"Outro","caption_start_s":220.04,"measure":98,"offset_ticks":402,"caption_confidence":"medium"},{"lyric_line_id":40,"text":"Over the coast, everyone's convinced","section":"Outro","caption_start_s":224.6,"measure":101,"offset_ticks":701,"caption_confidence":"medium"},{"lyric_line_id":41,"text":"It's a government drone or alien spaceship","section":"Outro","caption_start_s":229.08,"measure":103,"offset_ticks":1030,"caption_confidence":"medium"},{"lyric_line_id":42,"text":"Either way, we're not alone","section":"Outro","caption_start_s":233.88,"measure":106,"offset_ticks":735,"caption_confidence":"medium"},{"lyric_line_id":43,"text":"I'll find a new place to be from","section":"Outro","caption_start_s":238.6,"measure":108,"offset_ticks":888,"caption_confidence":"medium"},{"lyric_line_id":44,"text":"A haunted house with a picket fence","section":"Outro","caption_start_s":242.68,"measure":111,"offset_ticks":113,"caption_confidence":"medium"},{"lyric_line_id":45,"text":"To float around and ghost my friends","section":"Outro","caption_start_s":247.36,"measure":113,"offset_ticks":899,"caption_confidence":"medium-low"},{"lyric_line_id":46,"text":"No, I'm not afraid to disappear","section":"Outro","caption_start_s":251.44,"measure":116,"offset_ticks":497,"caption_confidence":"medium"},{"lyric_line_id":47,"text":"The billboard said the end is near","section":"Outro","caption_start_s":256.48,"measure":118,"offset_ticks":739,"caption_confidence":"medium-low"},{"lyric_line_id":48,"text":"I turned around, there was nothing there","s